# Copy to invoice/.env.local; use a separate Neon branch for development.
# Use the pooled URL for app traffic and the direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# App origin and managed Better Auth endpoint are different URLs.
APP_BASE_URL=http://localhost:4321
NEON_AUTH_BASE_URL=https://YOUR-ENDPOINT.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Private Neon S3 bucket on the same branch as the database.
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.c-1.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=REPLACE_WITH_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_SECRET
INVOICE_PDF_BUCKET=invoice-pdfs

INVOICE_NUMBER_PREFIX=INV
HOST=127.0.0.1
PORT=4321

# Production requires HTTPS APP_BASE_URL. On Vercel previews, omit APP_BASE_URL
# to use the trusted VERCEL_URL system variable; register that exact origin in Neon.
# Vercel uses packaged Chromium and /tmp. No render callback URL is required.
