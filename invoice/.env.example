# Local setup: vp run invoice:db generates invoice/.env.local with random secrets.
# Otherwise supply your own PostgreSQL connection and cryptographically random secret.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/invoice_studio
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_BASE_URL=http://localhost:4321
INVOICE_NUMBER_PREFIX=KM

# The render worker must call this same process, not a load balancer or external host.
INVOICE_RENDER_ORIGIN=http://127.0.0.1:4321
INVOICE_RUNTIME_DIR=.tools/invoice-runtime
HOST=127.0.0.1
PORT=4321

# Production: NODE_ENV=production and AUTH_BASE_URL=https://your-private-invoice-host
# Provision an owner explicitly using vp run invoice:user (hidden password prompt).
# For noninteractive provisioning set INVOICE_ADMIN_EMAIL and INVOICE_ADMIN_NAME,
# then provide the password on stdin. Do not store owner passwords in this file.
