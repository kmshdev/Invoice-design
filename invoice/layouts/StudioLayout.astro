---
import '../styles.css'
import '../platform.css'
interface Props {
  title?: string
}
const { title = 'Shardlane' } = Astro.props
---

<!doctype html>
<html lang="en" class="dark shardlane-app">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Create, review, issue, and archive invoices." />
    <link
      rel="preload"
      href="/fonts/berkeley-mono-tx02.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Skip to content</a><slot /></body>
</html>
