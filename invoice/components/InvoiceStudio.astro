---
import App from '../App'
import { frontmatter } from '../content/invoice.mdx'
import { parseInvoice } from '../model'

const initialInvoice = parseInvoice(JSON.stringify(frontmatter))
---

<App client:only="react" initialInvoice={initialInvoice} />
<noscript>Enable JavaScript to edit and save invoices locally in your browser.</noscript>
