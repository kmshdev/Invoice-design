{
  "name": "@oxide/design-system",
  "version": "6.7.0",
  "description": "Home of reusable design assets and token for oxide internal sites",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./styles/*": "./styles/*",
    "./components/*.css": "./dist/*.css",
    "./asciidoc": "./dist/components/src/asciidoc/index.js",
    "./syntax": "./dist/components/src/syntax/index.js",
    "./ui": "./dist/components/src/ui/index.js",
    "./icons": "./dist/icons/index.js",
    "./icons/react": "./dist/icons/react/index.js"
  },
  "scripts": {
    "dev": "astro dev --root invoice",
    "invoice:build": "astro build --root invoice",
    "invoice:check": "astro check --root invoice && tsc -p invoice/tsconfig.json",
    "export-icons": "npx zx ./scripts/export-icons.md && npm run fmt",
    "build": "tsup --dts",
    "release": "npm publish --provenance",
    "lint": "eslint --ext .js,.ts,.tsx,.json .",
    "fmt": "prettier --cache --write . && npm run lint -- --fix",
    "test": "vitest --config test/vitest.config.ts",
    "tsc": "tsc",
    "color-gen:watch": "tsx watch color-gen/generate.ts",
    "color-gen:dev": "vite --config color-gen/vite.config.ts color-gen",
    "color-gen:apply": "tsx color-gen/apply-colors.ts",
    "preview:dev": "vite --config preview/vite.config.ts",
    "design-md": "node scripts/design-md.mjs",
    "design-md:check": "node scripts/design-md.mjs --check",
    "invoice:vale:install": "node scripts/install-vale.mjs",
    "invoice:prose": "tsx scripts/invoice-prose.ts",
    "invoice:format": "prettier --write \"invoice/**/*.{ts,tsx,css,mdx,mjs}\" test/invoice.test.ts scripts/invoice-template.mjs scripts/invoice-prose.ts scripts/install-vale.mjs \"scripts/vale/styles/**/*.yml\"",
    "invoice:format:check": "prettier --check \"invoice/**/*.{ts,tsx,css,mdx,mjs}\" test/invoice.test.ts scripts/invoice-template.mjs scripts/invoice-prose.ts scripts/install-vale.mjs \"scripts/vale/styles/**/*.yml\""
  },
  "author": "Oxide Computer Company <bots@oxidecomputer.com>",
  "license": "MPL 2.0",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@figma-export/cli": "^6.3.0",
    "@figma-export/output-components-as-svg": "^6.2.4",
    "@figma-export/output-components-as-svgr": "^6.2.4",
    "@figma-export/transform-svg-with-svgo": "^6.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@stisla/style": "^3.0.1",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/culori": "^4.0.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/svg-sprite": "^0.0.39",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@vitejs/plugin-react": "^5.1.3",
    "astro": "^7.3.2",
    "culori": "^4.0.2",
    "dedent": "^1.7.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "svg-sprite": "^2.0.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0",
    "zx": "^8.8.3"
  },
  "peerDependencies": {
    "@asciidoctor/core": "^3.0.0",
    "@oxide/react-asciidoc": "^2.1.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@headlessui/react": "^2.2.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-tabs": "^1.1.13",
    "classnames": "^2.5.1",
    "kugiri": "^0.5.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "shiki": "^4.4.3"
  },
  "files": [
    "design.md",
    "styles/*.css",
    "icons/**/*.svg",
    "dist/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxidecomputer/design-system.git"
  },
  "bugs": {
    "url": "https://github.com/oxidecomputer/design-system/issues"
  },
  "homepage": "https://github.com/oxidecomputer/design-system#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
